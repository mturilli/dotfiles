# Homebrew belongs in the login-shell profile so it is initialized once.
# Check both standard macOS prefixes to keep this usable on Apple Silicon and
# Intel Macs without invoking `brew --prefix` during every shell startup.
if [[ -x /opt/homebrew/bin/brew ]]; then
    _brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
    _brew_bin=/usr/local/bin/brew
else
    _brew_bin=""
fi

if [[ -n "$_brew_bin" ]]; then
    eval "$("$_brew_bin" shellenv)"
fi
unset _brew_bin
