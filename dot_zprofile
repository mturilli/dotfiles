# Homebrew belongs in the login-shell profile so it is initialized once.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Make pyenv-managed interpreters available to login and non-interactive shells.
if (( $+commands[pyenv] )); then
    eval "$(pyenv init --path)"
fi
