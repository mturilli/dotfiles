# Keep interactive startup small, deterministic, and easy to profile.
typeset -a _zsh_config_files=(
    "$HOME/.config/zsh/env.zsh"
    "$HOME/.config/zsh/options.zsh"
    "$HOME/.config/zsh/completion.zsh"
    "$HOME/.config/zsh/aliases.zsh"
    "$HOME/.config/zsh/functions.zsh"
    "$HOME/.config/zsh/keybindings.zsh"
    "$HOME/.config/zsh/integrations.zsh"
)

for _zsh_config_file in "${_zsh_config_files[@]}"; do
    [[ -r "$_zsh_config_file" ]] && source "$_zsh_config_file"
done

unset _zsh_config_file _zsh_config_files
